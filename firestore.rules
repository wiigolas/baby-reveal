rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read/write RSVPs (no auth needed for a party app)
    match /rsvps/{doc} {
      allow read, write: if true;
    }

    // Anyone can read settings; anyone can write (admin uses password in UI, not Firebase auth)
    // NOTE: gender is NOT stored here — it lives in /secrets/config
    match /settings/{doc} {
      allow read, write: if true;
    }

    // Extra name guesses for the other gender (submitted from the home page after RSVP)
    match /extra_name_guesses/{doc} {
      allow read, write: if true;
    }

    // Gender is stored here and only becomes readable AFTER the reveal.
    // This prevents guests from inspecting network requests to find the answer.
    match /secrets/{doc} {
      allow read: if get(/databases/$(database)/documents/settings/config).data.revealPhase == 'revealed';
      allow write: if true; // Admin writes without Firebase auth
    }
  }
}
